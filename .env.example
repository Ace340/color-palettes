# Copy to .env.local for development, and set the same values in your Vercel
# project (Project Settings → Environment Variables) for Production + Preview.

# --- Required: AI Mood Generation (server-side only) ----------------------
# Z.AI (Zhipu) API key. Create one at https://z.ai/.
# Without this, the AI mood feature returns NOT_CONFIGURED (degrades gracefully).
ZAI_API_KEY=

# --- Required for production: rate limiting / cost control -----------------
# Create a free Redis database at https://upstash.com/ and copy its REST values.
# When UNSET, the limiter FAILS OPEN (no limit) — fine for local dev, but in
# production this means the paid Z.AI endpoint is unprotected. See
# docs/adr/0006-upstash-ratelimit-for-cost-control.md
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: canonical site origin --------------------------------------
# Used by metadata, sitemap.ts, and robots.ts. Set this to your production
# domain so canonical / Open Graph URLs resolve correctly. Server-side only.
# Defaults to https://chromattic.vercel.app when unset.
# SITE_URL=https://yourdomain.com

# --- Optional: Google Search Console verification -------------------------
# Emits <meta name="google-site-verification"> so you can claim the site in
# Search Console. Get the token from Search Console → Add property → HTML tag.
# Leave unset until you have a token; the tag is omitted when blank.
# GOOGLE_SITE_VERIFICATION=
